[Unit]
Description=AI Lounge FastAPI backend
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/wia/projects/ailounge/backend
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/wia/projects/ailounge/backend/.venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 9002
Restart=always
RestartSec=2
TimeoutStopSec=20
KillSignal=SIGINT

[Install]
WantedBy=default.target
