# Backend - PostgreSQL
# Python/FastAPI는 JDBC URL이 아니라 아래 libpq 접속 정보를 사용합니다.
DB_HOST=10.65.109.95
DB_PORT=5432
DB_NAME=data_catalog
DB_USER=data_catalog
# 평문 또는 Portal 호환 ENC(...) 값을 지원합니다. 운영에서는 DB_CRYPT_KEY를 별도 Secret으로 주입하세요.
DB_PASSWORD=ENC(replace-with-portal-compatible-ciphertext)
DB_CRYPT_KEY=replace-with-a-separate-secret
DB_SCHEMA=ai_studio
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=3
DB_POOL_TIMEOUT_SECONDS=10

# Portal 인증 토큰 검증. 운영에서는 Kubernetes Secret 등으로 주입하세요.
PORTAL_JWT_SECRET=replace-with-portal-access-token-secret
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:9001,http://127.0.0.1:9001

# Backend - Azure OpenAI
# backend/llm_client.py에서 사용합니다.
OPENAI_MODEL=gpt-5.5
OPENAI_API_KEY=your-azure-openai-api-key
OPENAI_BASE_URL=https://your-resource-name.openai.azure.com
OPENAI_API_VERSION=2025-04-01-preview

# Backend - Gmail SMTP
# Gmail 계정의 일반 비밀번호가 아닌 앱 비밀번호를 사용합니다.
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=465
MAIL_SMTP_TIMEOUT_SECONDS=30
MAIL_SENDER_EMAIL=dxlabailounge@gmail.com
MAIL_SENDER_NAME=AI Lounge
MAIL_GMAIL_APP_PASSWORD=your-gmail-app-password
