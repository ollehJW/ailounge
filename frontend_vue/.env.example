# 별도 포트로 실행하는 AI Lounge 백엔드의 Origin입니다.
VITE_API_BASE=
VITE_DEV_API_TARGET=http://127.0.0.1:9002

# standalone: 독립 헤더/Breadcrumb/Footer 표시, embedded: Portal 콘텐츠만 표시
VITE_LAYOUT_MODE=standalone

# 독립 Vue Router의 배포 기준 경로입니다. Portal 통합 후 Router와 함께 제거합니다.
VITE_ROUTER_BASE=/

# 하위 경로에 독립 빌드를 배포할 때 사용하는 Vite asset 기준 경로입니다.
VITE_APP_BASE=/
